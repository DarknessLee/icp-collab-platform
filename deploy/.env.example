# =============================================================================
# 企业内控与协同运营管理平台 V1.0 - Compose 环境变量样例
# 用法：cp .env.example .env 后按需修改；.env 不要提交到仓库。
# 左侧变量名与 backend/src/main/resources/application.yml 的 ${ENV:default}
# 占位保持一致；容器内部端口固定（MySQL 3306 / Backend 8080 / Nginx 80）。
# =============================================================================

# ---- 数据库 ----
# MySQL root 口令（仅容器内部使用）
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
# 业务库名，必须与后端 DB_URL 中的库名一致
MYSQL_DATABASE=icp_platform
# 应用账号/口令（与后端 DB_USERNAME / DB_PASSWORD 对应）
APP_DB_USER=icp_app
APP_DB_PASSWORD=ChangeMe_App_2026
# 宿主机映射端口（本机 3307 已被本地实例占用，默认用 13307 避免冲突）
MYSQL_PORT=13307

# ---- 后端 ----
# JWT HMAC key（base64）。生成示例：
#   openssl rand -base64 48
JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1kZW1vLWp3dC1rZXktYmFzZTY0LWtleQ==
# 宿主机映射端口（Nginx 已在 8080 提供前端，后端直连仅用于调试）
BACKEND_PORT=8081
# CORS 允许源；同源经 Nginx 反代时可保持默认
CORS_ORIGINS=http://localhost:8080

# ---- 前端 ----
# 宿主机访问端口：http://localhost:8080
FRONTEND_PORT=8080

# ---- MinIO（二期对象存储预留，当前后端使用本地磁盘）----
MINIO_ROOT_USER=icpminio
MINIO_ROOT_PASSWORD=ChangeMe_Minio_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
